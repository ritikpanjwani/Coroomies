# Staging template for CoRoomies backend.
# Copy to backend/.env on your staging server (never commit actual secrets).
ENVIRONMENT=staging
DEV_MODE=false
DATABASE_URL=postgresql://staging_user:staging_password@staging_db_host:5432/coroomies_staging
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
OTP_PEPPER_KEY=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=https://staging.example.com
CORS_ALLOW_TUNNELS=false
APP_TIMEZONE=UTC
CONTENT_SECURITY_POLICY=default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; form-action 'self'; img-src 'self' data: blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT_SECONDS=5
LOG_LEVEL=INFO
# Staging Redis instance for distributed rate limiting.
REDIS_URL=redis://staging_redis_host:6379/0
# In staging, fail closed (503) if Redis is down or unconfigured to ensure staging matches production behavior.
RATE_LIMIT_FAIL_CLOSED=true
# Upstream reverse proxy / load balancer IP or CIDR block (e.g. 127.0.0.1, 10.0.0.0/8).
# Forwarded client IP headers are accepted ONLY from matching peer socket addresses.
TRUSTED_PROXIES=127.0.0.1,::1
# Staging outbound SMTP credentials for testing password reset and email change flows.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=staging-noreply@example.com
SMTP_PASS=replace-with-smtp-app-password

# Private Supabase Storage buckets. The service-role key belongs only on Render.
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_CHAT_BUCKET=chat-media
SUPABASE_AVATAR_BUCKET=profile-avatars
SUPABASE_GROUP_AVATAR_BUCKET=group-avatars
