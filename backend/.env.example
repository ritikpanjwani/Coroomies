# Production template. Copy to backend/.env (never commit it) and restrict
# file permissions to the service account and administrators.
ENVIRONMENT=production
DEV_MODE=false
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/coroomies
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
OTP_PEPPER_KEY=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=https://app.example.com
CORS_ALLOW_TUNNELS=false
APP_TIMEZONE=UTC
CONTENT_SECURITY_POLICY=default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; form-action 'self'; img-src 'self' data: blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT_SECONDS=5
LOG_LEVEL=INFO
# Shared Redis instance for atomic distributed rate limiting across workers.
# In production, required for distributed synchronization across workers and instances.
REDIS_URL=redis://localhost:6379/0
# Rate limiting failure policy:
# In production, defaults to true. When true, if Redis is down or unconfigured,
# sensitive endpoints fail closed with HTTP 503 instead of downgrading to per-process in-memory limits.
# In development, defaults to false for convenience (falls back to local in-memory limiting).
RATE_LIMIT_FAIL_CLOSED=true
# Comma-separated list of trusted upstream reverse proxies / load balancers.
# CRITICAL FOR PRODUCTION: In production, this MUST match your real hosting proxy / load balancer
# or Cloudflare egress IP range (e.g. 10.0.0.1, 172.16.0.0/12, 127.0.0.1).
# Client IP headers (CF-Connecting-IP, X-Forwarded-For) are accepted ONLY when the immediate
# socket peer matches this list. If left empty in production, forwarded headers are ignored
# and the direct socket peer IP is used, preventing header spoofing attacks.
TRUSTED_PROXIES=127.0.0.1,::1
# Real outbound email is required for password reset and email changes.
# Port 587 uses STARTTLS. Use a provider app password, not your login password.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=replace-with-smtp-app-password

# Chat media upload limits & secure storage configuration
# Maximum image size in bytes (default 10 MB = 10485760)
MAX_CHAT_IMAGE_BYTES=10485760
# Maximum video size in bytes (default 50 MB = 52428800)
MAX_CHAT_VIDEO_BYTES=52428800
# Optional custom directory for chat media storage (defaults to backend/data/chat_media)
CHAT_MEDIA_STORAGE_DIR=
