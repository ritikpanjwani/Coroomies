# Copy to frontend/.env.production (ignored by git) or pass VITE_API_URL in
# the build environment. This must be the public HTTPS origin of the backend.
# Production builds fail if this is missing or points at localhost/loopback/
# Cloudflare Quick Tunnel hosts.
VITE_API_URL=https://api.example.com
VITE_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Only affects the local Vite dev/preview servers. Configure HSTS at the
# production static host/reverse proxy instead.
VITE_HSTS_ENABLED=false
