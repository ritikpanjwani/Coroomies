# Staging frontend template.
# Copy to frontend/.env.staging or pass VITE_API_URL during staging build.
# Must be the public HTTPS origin of your staging API.
VITE_API_URL=https://api-staging.example.com
VITE_GOOGLE_CLIENT_ID=your-staging-web-client-id.apps.googleusercontent.com

# Only affects the local Vite dev/preview servers.
VITE_HSTS_ENABLED=false
